{
  "mcpServers": {
    "umami": {
      "command": "bun",
      "args": ["run", "${CLAUDE_PLUGIN_ROOT}/index.ts"],
      "env": {
        "UMAMI_API_KEY": "${UMAMI_API_KEY}",
        "UMAMI_BASE_URL": "${UMAMI_BASE_URL}",
        "UMAMI_USERNAME": "${UMAMI_USERNAME}",
        "UMAMI_PASSWORD": "${UMAMI_PASSWORD}",
        "UMAMI_DEFAULT_WEBSITE_ID": "${UMAMI_DEFAULT_WEBSITE_ID}"
      }
    }
  }
}
